//ROUTE.HTTP tem a função de testar as ROTAS URL.
//NÃO é necessario para o código,
//necessario apenas para manter sanidade mental

// --------------------------
// Abrigos

POST http://localhost:3000/api/abrigos/cadastrar
Content-Type: application/json

{
  "nome": "Abrigo Teste",
  "cep": "12000-000",
  "cidadeId": 1,
  "endereco": "Rua Teste, 123",
  "telefone": "12123456789",
  "responsavel": "João Abrigos",
  "tipoAbrigo": "emergencial",
  "capacidadeTotal": 50,
  "capacidadeOcupada": 20,
  "possuiAtendimentoMedico": false,
  "status": "ativo"
}

###

GET http://localhost:3000/api/abrigos/listar

###

GET http://localhost:3000/api/abrigos/listar?nome=Teste
// GET com filtro por nome

###

GET http://localhost:3000/api/abrigos/listar?endereco=Rua
// GET com filtro por endereco

###

PUT http://localhost:3000/api/abrigos/atualizar/3
Content-Type: application/json

{
  "nome": "Abrigo Teste Atualizado",
  "cep": "12000-000",
  "cidadeId": 1,
  "endereco": "Rua Teste, 123",
  "telefone": "12123456789",
  "responsavel": "João Abrigos",
  "tipoAbrigo": "emergencial",
  "capacidadeTotal": 50,
  "capacidadeOcupada": 30,
  "possuiAtendimentoMedico": false,
  "status": "ativo"
}

###

DELETE http://localhost:3000/api/abrigos/excluir/3


###


// --------------------------
// Regioes: Estado → Cidade → Bairro
// (rotas de cadastro/edição exigem login de admin:
//  Authorization: Bearer <token do /api/auth/login>)

GET http://localhost:3000/api/estados/listar

###

GET http://localhost:3000/api/cidades/listar?estadoId=25

###

POST http://localhost:3000/api/cidades/cadastrar
Content-Type: application/json
Authorization: Bearer COLE_O_TOKEN_AQUI

{
  "nome": "Caçapava",
  "estadoId": 25
}

###

PUT http://localhost:3000/api/cidades/atualizar/1
Content-Type: application/json
Authorization: Bearer COLE_O_TOKEN_AQUI

{
  "grupoWhatsappId": "120363012345678901@g.us"
}

###

GET http://localhost:3000/api/bairros/listar?cidadeId=1

###

GET http://localhost:3000/api/bairros/cep/12070610
// Consulta o ViaCEP e diz se a cidade/bairro já estão cadastrados

###

POST http://localhost:3000/api/bairros/cadastrar
Content-Type: application/json
Authorization: Bearer COLE_O_TOKEN_AQUI

{
  "nome": "Centro",
  "cidadeId": 1,
  "populacaoEstimada": 40000,
  "areaKm2": 12.5,
  "nivelRisco": "medio"
}

###

DELETE http://localhost:3000/api/bairros/excluir/1
Authorization: Bearer COLE_O_TOKEN_AQUI

###


// --------------------------
// Voluntário logado se vincula a um abrigo (abrigoId: null para se desvincular)

PATCH http://localhost:3000/api/voluntarios/me/abrigo
Authorization: Bearer COLE_O_TOKEN_DO_VOLUNTARIO_AQUI
Content-Type: application/json

{
  "abrigoId": 1
}

###


// --------------------------
// Mapa (admin ou voluntário logado) — alertas ativos para os círculos do mapa

GET http://localhost:3000/api/mapa/alertas
Authorization: Bearer COLE_O_TOKEN_AQUI

###


// --------------------------
// Alertas (painel admin — exige login de admin)

GET http://localhost:3000/api/alertas/listar?status=em_verificacao
Authorization: Bearer COLE_O_TOKEN_AQUI

###

GET http://localhost:3000/api/alertas/listar/1
Authorization: Bearer COLE_O_TOKEN_AQUI

###

PATCH http://localhost:3000/api/alertas/cancelar/1
Content-Type: application/json
Authorization: Bearer COLE_O_TOKEN_AQUI

{
  "motivo": "Relato falso"
}

###

GET http://localhost:3000/api/inscritos/listar?busca=maria
Authorization: Bearer COLE_O_TOKEN_AQUI

###


// --------------------------
// Rotas do ChatBot (exigem o cabeçalho x-bot-key = BOT_API_KEY do .env)

POST http://localhost:3000/api/bot/alertas/relatar
Content-Type: application/json
x-bot-key: COLE_A_CHAVE_AQUI

{
  "whatsappId": "5512999999999@c.us",
  "tipo": "alagamento",
  "gravidade": "grave",
  "bairroId": 1,
  "foto": "BASE64_DA_FOTO",
  "fotoMimetype": "image/jpeg"
}

###

