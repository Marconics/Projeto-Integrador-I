generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────

model Admin {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  cargo       String   @default("operador")
  orgao       String?
  nivelAcesso String   @default("operador")
  createdAt   DateTime @default(now()) @map("created_at")

  solicitacoesAnalisadas   SolicitacaoAbrigo[]
  convitesResponsavel      ConviteResponsavel[]
  solicitacoesAjudaCriadas SolicitacaoAjuda[]  @relation("SolicitacoesAjudaCriadas")
  alertasAnalisados        Alerta[]

  @@map("admin")
}

// ─────────────────────────────────────────────
// REGIÕES: ESTADO → CIDADE → BAIRRO
// Substitui a antiga tabela "regiao", que repetia cidade e estado
// como texto em cada bairro.
// ─────────────────────────────────────────────

model Estado {
  id_estado Int    @id @default(autoincrement())
  nome      String
  sigla     String @unique @db.VarChar(2)

  cidades Cidade[]

  @@map("estado")
}

model Cidade {
  id_cidade Int    @id @default(autoincrement())
  nome      String

  estadoId Int
  estado   Estado @relation(fields: [estadoId], references: [id_estado])

  // ID do grupo de WhatsApp que recebe os alertas da cidade (ex: 1203630@g.us)
  // Pode ser preenchido pelo painel ou pelo comando "!alertas vincular" no grupo
  grupoWhatsappId String?
  // Link de convite do grupo (https://chat.whatsapp.com/...) — o bot envia
  // para quem quiser entrar no grupo de alertas da cidade
  grupoWhatsappLink String?

  createdAt DateTime @default(now()) @map("created_at")

  bairros            Bairro[]
  abrigos            Abrigo[]
  solicitacoesAbrigo SolicitacaoAbrigo[]
  notificacoes       Notificacao[]

  @@unique([nome, estadoId])
  @@map("cidade")
}

enum NivelRisco {
  baixo
  medio
  alto
  critico
}

model Bairro {
  id_bairro Int    @id @default(autoincrement())
  nome      String

  cidadeId Int
  cidade   Cidade @relation(fields: [cidadeId], references: [id_cidade])

  populacaoEstimada Int?
  areaKm2           Float?
  nivelRisco        NivelRisco @default(baixo)
  createdAt         DateTime   @default(now()) @map("created_at")

  abrigos               Abrigo[]
  solicitacoesAbrigo    SolicitacaoAbrigo[]
  moradores             InscritoAlerta[]
  inscritosInteressados InscritoBairro[]
  alertas               Alerta[]

  @@unique([nome, cidadeId])
  @@map("bairro")
}

// ─────────────────────────────────────────────
// ABRIGO
// ─────────────────────────────────────────────

model Abrigo {
  id_abrigo               Int      @id @default(autoincrement())
  nome                    String
  cep                     String   @db.VarChar(9)
  endereco                String
  latitude                Float?
  longitude               Float?
  telefone                String?
  responsavel             String?
  tipoAbrigo              String
  capacidadeTotal         Int
  capacidadeOcupada       Int      @default(0)
  possuiAtendimentoMedico Boolean  @default(false)
  possuiEnfermagem        Boolean  @default(false)
  possuiPets              Boolean  @default(false)
  possuiAcessibilidade    Boolean  @default(false)
  possuiCozinha           Boolean  @default(false)
  fotoAbrigo              String?
  status                  String   @default("ativo")
  createdAt               DateTime @default(now()) @map("created_at")

  // Localização: a cidade é obrigatória, o bairro é opcional
  // (o estado vem pela cidade)
  cidadeId Int
  cidade   Cidade  @relation(fields: [cidadeId], references: [id_cidade])
  bairroId Int?
  bairro   Bairro? @relation(fields: [bairroId], references: [id_bairro])

  solicitacao       SolicitacaoAbrigo?
  vitimas           Vitima[]
  voluntarios       Voluntario[]
  solicitacoesAjuda SolicitacaoAjuda[]

  // Responsáveis que recebem os avisos do abrigo pelo WhatsApp
  responsaveis        ResponsavelAbrigo[]
  convitesResponsavel ConviteResponsavel[]
  // Voluntários que recebem os pedidos de ajuda do abrigo pelo WhatsApp
  voluntariosWhatsapp VoluntarioWhatsapp[]

  @@map("abrigo")
}

// ─────────────────────────────────────────────
// VÍTIMA
// ─────────────────────────────────────────────

model Vitima {
  id_vitima      Int       @id @default(autoincrement())
  nome           String
  cpf            String?   @db.VarChar(14)
  telefone       String?   @unique @db.VarChar(15)
  dataNascimento DateTime  @db.Date
  genero         String
  fotoVitima     String?
  dataEntrada    DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  deficiencias VitimaDeficiencia[]
}

model Deficiencia {
  id_deficiencia Int    @id @default(autoincrement())
  nome           String @unique

  vitimas VitimaDeficiencia[]
}

model VitimaDeficiencia {
  id_vitima      Int
  id_deficiencia Int

  vitima      Vitima      @relation(fields: [id_vitima], references: [id_vitima])
  deficiencia Deficiencia @relation(fields: [id_deficiencia], references: [id_deficiencia])

  @@id([id_vitima, id_deficiencia])
}

// ─────────────────────────────────────────────
// VOLUNTÁRIO
// ─────────────────────────────────────────────

model Voluntario {
  id_voluntario  Int      @id @default(autoincrement())
  nome           String
  cpf            String?  @db.VarChar(14)
  telefone       String?  @db.VarChar(15)
  email          String   @unique
  senha          String
  dataNascimento DateTime @db.Date
  genero         String
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @map("created_at")

  abrigoId Int?
  abrigo   Abrigo? @relation(fields: [abrigoId], references: [id_abrigo])

  solicitacoesAjudaAtendidas SolicitacaoAjuda[]
  interessesAjuda            SolicitacaoAjudaInteresse[]

  @@map("voluntario")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE ABRIGO
// ─────────────────────────────────────────────

enum StatusSolicitacao {
  pendente
  aprovado
  recusado
}

model SolicitacaoAbrigo {
  id_solicitacao Int @id @default(autoincrement())

  nome                    String
  cep                     String  @db.VarChar(9)
  endereco                String
  telefone                String? @db.VarChar(15)
  responsavel             String
  tipoAbrigo              String
  capacidadeTotal         Int
  possuiAtendimentoMedico Boolean @default(false)
  possuiEnfermagem        Boolean @default(false)
  possuiPets              Boolean @default(false)
  possuiAcessibilidade    Boolean @default(false)
  possuiCozinha           Boolean @default(false)
  fotoAbrigo              String?

  cidadeId Int
  cidade   Cidade  @relation(fields: [cidadeId], references: [id_cidade])
  bairroId Int?
  bairro   Bairro? @relation(fields: [bairroId], references: [id_bairro])

  solicitanteNome     String
  solicitanteEmail    String
  solicitanteTelefone String? @db.VarChar(15)
  // Respostas do bot (só o bot, com a chave dele, preenche — o WhatsApp é um número comprovado):
  //  - quem pediu é o responsável (dono) do local?
  //  - se é: quer receber os avisos do abrigo (vira convite de responsável ao aprovar)
  //  - se não é: quer ser voluntário (entra na lista de voluntários do abrigo ao aprovar)
  solicitanteWhatsappId    String?
  solicitanteEhResponsavel Boolean @default(false)
  aceitaAvisosWhatsapp     Boolean @default(false)
  querVoluntariar          Boolean @default(false)

  status       StatusSolicitacao @default(pendente)
  motivoRecusa String?

  analisadoPorId Int?
  analisadoPor   Admin?    @relation(fields: [analisadoPorId], references: [id])
  dataAnalise    DateTime?

  abrigo_id Int?    @unique
  abrigo    Abrigo? @relation(fields: [abrigo_id], references: [id_abrigo])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("solicitacao_abrigo")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE AJUDA  (substitui Doacao)
// ─────────────────────────────────────────────

enum StatusSolicitacaoAjuda {
  aberto
  em_andamento
  concluido
  cancelado
}

enum CategoriaAjuda {
  doacao // roupas, alimentos, itens em geral
  medicamento // remédios, insumos médicos
  voluntariado // mão de obra, serviços presenciais
  infraestrutura // reparos, equipamentos
  outro // pedido livre / personalizado
}

enum UrgenciaAjuda {
  baixa
  media
  alta
  critica
}

model SolicitacaoAjuda {
  id_solicitacao Int @id @default(autoincrement())

  // Conteúdo livre — o ADM descreve o que precisa
  titulo    String
  descricao String
  categoria CategoriaAjuda
  urgencia  UrgenciaAjuda  @default(media)

  status StatusSolicitacaoAjuda @default(aberto)

  // Observação interna preenchida ao concluir ou cancelar
  observacaoFechamento String?

  // ADM que criou a solicitação
  criadoPorId Int
  criadoPor   Admin @relation("SolicitacoesAjudaCriadas", fields: [criadoPorId], references: [id])

  // Abrigo ao qual a solicitação pertence (sempre obrigatório)
  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo])

  // Voluntário que atendeu — preenchido opcionalmente ao concluir
  // Pode ficar nulo (anônimo ou sem vínculo)
  voluntarioId Int?
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id_voluntario])

  interesses SolicitacaoAjudaInteresse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([abrigoId])
  @@index([categoria])
  @@index([createdAt])
  @@map("solicitacao_ajuda")
}

// Registro de interesse do voluntário
// — somente visual, sem poder de gestão
// — um voluntário não pode marcar interesse duas vezes na mesma solicitação
model SolicitacaoAjudaInteresse {
  id Int @id @default(autoincrement())

  solicitacaoId Int
  solicitacao   SolicitacaoAjuda @relation(fields: [solicitacaoId], references: [id_solicitacao])

  voluntarioId Int
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id_voluntario])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([solicitacaoId, voluntarioId])
  @@map("solicitacao_ajuda_interesse")
}

// ─────────────────────────────────────────────
// SISTEMA DE ALERTAS
//
// Fluxo:
//   1. O morador se inscreve pelo bot (InscritoAlerta) informando nome,
//      e-mail e o bairro onde mora. Pode acompanhar outros bairros
//      (InscritoBairro).
//   2. Ele relata uma ocorrência respondendo perguntas fechadas
//      (tipo, gravidade) + foto → vira um RelatoAlerta.
//   3. Relatos do mesmo tipo no mesmo bairro são agrupados em um Alerta.
//      Enquanto não atinge o mínimo de relatos (ALERTA_CONFIRMACOES_MINIMAS),
//      o alerta fica "em_verificacao".
//   4. Ao atingir o mínimo (ou se um admin confirmar), o alerta vira "ativo"
//      e são geradas as Notificacoes: uma para cada inscrito que mora ou
//      acompanha o bairro e uma para o grupo de WhatsApp da cidade.
//   5. O bot busca as notificações pendentes na API e as envia.
// ─────────────────────────────────────────────

model InscritoAlerta {
  id_inscrito Int    @id @default(autoincrement())
  nome        String
  email       String

  // ID do chat no WhatsApp (ex: 5512999999999@c.us). É para ele que o bot
  // envia as notificações, por isso é único.
  whatsappId String  @unique
  telefone   String? @db.VarChar(20)

  ativo Boolean @default(true)

  // Bairro onde a pessoa mora — sempre recebe os alertas dele
  bairroId Int
  bairro   Bairro @relation(fields: [bairroId], references: [id_bairro])

  // Bairros extras que a pessoa escolheu acompanhar
  bairrosInteresse InscritoBairro[]
  relatos          RelatoAlerta[]
  notificacoes     Notificacao[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bairroId])
  @@map("inscrito_alerta")
}

model InscritoBairro {
  inscritoId Int
  inscrito   InscritoAlerta @relation(fields: [inscritoId], references: [id_inscrito], onDelete: Cascade)
  bairroId   Int
  bairro     Bairro         @relation(fields: [bairroId], references: [id_bairro], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([inscritoId, bairroId])
  @@map("inscrito_bairro")
}

enum TipoAlerta {
  alagamento
  deslizamento
  arvore_caida
  falta_energia
  incendio
  via_interditada
  vendaval
}

enum GravidadeAlerta {
  leve
  medio
  grave
}

enum StatusAlerta {
  em_verificacao // aguardando confirmação de outros moradores
  ativo // confirmado e disparado
  encerrado // ocorrência resolvida
  cancelado // cancelado por um admin (ex: alerta falso)
}

model Alerta {
  id_alerta Int             @id @default(autoincrement())
  tipo      TipoAlerta
  // Gravidade mais relatada entre os relatos (empate → a mais grave)
  gravidade GravidadeAlerta
  status    StatusAlerta    @default(em_verificacao)

  bairroId Int
  bairro   Bairro @relation(fields: [bairroId], references: [id_bairro])

  disparadoEm       DateTime?
  // true quando o admin disparou antes de atingir o mínimo de relatos
  disparadoPorAdmin Boolean   @default(false)

  // Preenchidos quando um admin confirma, encerra ou cancela o alerta
  analisadoPorId     Int?
  analisadoPor       Admin?    @relation(fields: [analisadoPorId], references: [id], onDelete: SetNull)
  motivoCancelamento String?
  finalizadoEm       DateTime?

  relatos      RelatoAlerta[]
  notificacoes Notificacao[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bairroId, tipo, status])
  @@index([status])
  @@index([createdAt])
  @@map("alerta")
}

model RelatoAlerta {
  id_relato Int @id @default(autoincrement())

  alertaId Int
  alerta   Alerta @relation(fields: [alertaId], references: [id_alerta], onDelete: Cascade)

  // Se o inscrito for excluído, o relato continua contando para o alerta
  inscritoId Int?
  inscrito   InscritoAlerta? @relation(fields: [inscritoId], references: [id_inscrito], onDelete: SetNull)

  gravidade  GravidadeAlerta
  fotoRelato String?

  createdAt DateTime @default(now()) @map("created_at")

  // A mesma pessoa não pode confirmar o mesmo alerta duas vezes
  @@unique([alertaId, inscritoId])
  @@map("relato_alerta")
}

enum EventoNotificacao {
  disparo // aviso do alerta
  cancelamento // correção enviada quando o admin cancela um alerta já disparado
  convite_responsavel // pergunta se a pessoa é responsável por um abrigo
  aviso_responsavel // avisos do abrigo (vínculo, voluntário interessado...)
  pedido_ajuda // novo pedido de ajuda do abrigo, para os voluntários no WhatsApp
  aviso_voluntario // boas-vindas e saída da lista de voluntários do abrigo
}

enum DestinoNotificacao {
  inscrito
  grupo
  responsavel
  voluntario
}

enum StatusNotificacao {
  pendente
  enviando
  enviada
  falha
  cancelada
}

// Fila de saída: a API cria as notificações e o bot (que tem a sessão do
// WhatsApp) as envia e informa o resultado.
model Notificacao {
  id_notificacao Int @id @default(autoincrement())

  // Vazio nas mensagens que não são de alerta (convite e avisos dos responsáveis de abrigo)
  alertaId Int?
  alerta   Alerta? @relation(fields: [alertaId], references: [id_alerta], onDelete: Cascade)

  // Convite de responsável que esta mensagem leva (para cancelar junto com o convite)
  conviteId Int?
  convite   ConviteResponsavel? @relation(fields: [conviteId], references: [id_convite], onDelete: SetNull)

  evento      EventoNotificacao  @default(disparo)
  tipoDestino DestinoNotificacao
  // whatsappId do inscrito ou do responsável, ou ID do grupo da cidade
  destino     String

  inscritoId Int?
  inscrito   InscritoAlerta? @relation(fields: [inscritoId], references: [id_inscrito], onDelete: SetNull)
  cidadeId   Int?
  cidade     Cidade?         @relation(fields: [cidadeId], references: [id_cidade], onDelete: SetNull)

  mensagem String
  fotoUrl  String?

  status     StatusNotificacao @default(pendente)
  tentativas Int               @default(0)
  erro       String?
  enviadaEm  DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Impede enviar o mesmo aviso duas vezes para o mesmo destino
  @@unique([alertaId, evento, destino])
  @@index([status])
  @@map("notificacao")
}

// ─────────────────────────────────────────────
// RESPONSÁVEIS DO ABRIGO NO WHATSAPP
// ─────────────────────────────────────────────

// Como o admin conferiu que a pessoa é mesmo responsável pelo abrigo
enum MetodoConferencia {
  solicitacao_aprovada // pediu o abrigo pelo bot, declarou ser o responsável e a solicitação foi aprovada
  numero_do_cadastro // celular que já estava no cadastro do abrigo
  ligacao_contato_oficial // o admin ligou para um contato oficial do local
  orgao_publico // confirmado com a prefeitura / Defesa Civil
  presencial // código entregue pessoalmente no abrigo
}

enum OrigemConvite {
  solicitacao
  admin
}

enum StatusConvite {
  pendente
  aceito
  recusado
  cancelado
}

// Convite para ser responsável. Vai por mensagem do bot (a pessoa responde
// ACEITAR) ou por link/código (a pessoa envia "vincular 123456" ao bot).
// Só vira vínculo quando a própria pessoa responde do número dela.
model ConviteResponsavel {
  id_convite Int @id @default(autoincrement())

  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo], onDelete: Cascade)

  nome       String?
  // Convite por mensagem: celular (só dígitos, com o 55) e/ou o WhatsApp já conhecido
  telefone   String? @db.VarChar(20)
  whatsappId String?
  // Convite por link: hash do código de 6 dígitos (o código só aparece uma vez, para o admin)
  codigoHash String?

  origem            OrigemConvite
  metodoConferencia MetodoConferencia
  observacao        String?

  status       StatusConvite @default(pendente)
  expiraEm     DateTime
  respondidoEm DateTime?

  criadoPorId Int?
  criadoPor   Admin? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  responsavel  ResponsavelAbrigo?
  notificacoes Notificacao[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([abrigoId])
  @@index([status])
  @@index([codigoHash])
  @@map("convite_responsavel")
}

// Pessoa que recebe os avisos do abrigo no WhatsApp
model ResponsavelAbrigo {
  id_responsavel Int @id @default(autoincrement())

  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo], onDelete: Cascade)

  nome       String
  whatsappId String
  telefone   String? @db.VarChar(20)
  ativo      Boolean @default(true)

  // Convite aceito que criou o vínculo (mostra como o número foi conferido)
  conviteId Int?                @unique
  convite   ConviteResponsavel? @relation(fields: [conviteId], references: [id_convite], onDelete: SetNull)

  desativadoEm DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([abrigoId])
  @@index([whatsappId])
  @@map("responsavel_abrigo")
}

// Voluntário do abrigo pelo WhatsApp (sem conta no painel). Hoje entra quem
// indicou o local pelo bot, disse que NÃO é o responsável e quis se voluntariar:
// ao aprovar a solicitação, passa a receber os pedidos de ajuda do abrigo.
// Sai com "sair voluntario" no bot ou pelo painel (Detalhes do abrigo).
model VoluntarioWhatsapp {
  id_voluntario_whatsapp Int @id @default(autoincrement())

  abrigoId Int
  abrigo   Abrigo @relation(fields: [abrigoId], references: [id_abrigo], onDelete: Cascade)

  nome       String
  whatsappId String
  telefone   String? @db.VarChar(20)
  ativo      Boolean @default(true)

  // Solicitação de abrigo em que a pessoa se ofereceu
  solicitacaoId Int?

  desativadoEm DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([abrigoId, whatsappId])
  @@index([whatsappId])
  @@map("voluntario_whatsapp")
}
